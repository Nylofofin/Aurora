<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Smaller orb, with clear breathing room inside Android's adaptive mask. -->
    <path android:pathData="M54,25a29,29 0,1 0,0 58a29,29 0,1 0,0 -58z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="40"
                android:centerY="35"
                android:gradientRadius="59">
                <item android:color="#E7FBFF" android:offset="0" />
                <item android:color="#55C8FF" android:offset="0.48" />
                <item android:color="#4268F5" android:offset="0.76" />
                <item android:color="#733DE0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Deep violet current gives the lower half a richer, layered gradient. -->
    <path android:pathData="M28,58c8,-8 17,-10 26,-5c9,5 16,8 27,2c-2,16 -13,28 -27,28c-13,0 -24,-8 -28,-20c1,-2 1,-3 2,-5z">
        <aapt:attr name="android:fillColor">
