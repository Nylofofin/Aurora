                <item android:color="#F4FBFF" android:offset="0.45" />
                <item android:color="#BDEEFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fluid cyan-to-blue horizon, the signature Aurora color transition. -->
    <path android:pathData="M26,57c9,-8 18,-9 28,-3c9,5 17,7 28,0c-5,8 -13,13 -21,13c-13,0 -20,-11 -34,-5c-1,-2 -1,-3 -1,-5z">
