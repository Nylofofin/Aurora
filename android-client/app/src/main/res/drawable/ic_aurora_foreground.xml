    <!-- Soft specular reflection adds a glassy, dimensional finish. -->
    <path
        android:fillColor="#78FFFFFF"
        android:pathData="M34,39c4,-5 10,-8 16,-8c-7,3 -12,9 -14,16c-1,4 -3,6 -5,7c0,-5 1,-10 3,-15z" />

