        android:pathData="M72,30c1.2,4.1 2.6,5.5 6.5,6.5c-3.9,1 -5.3,2.4 -6.5,6.5c-1,-4.1 -2.4,-5.5 -6.5,-6.5c4.1,-1 5.5,-2.4 6.5,-6.5z" />
