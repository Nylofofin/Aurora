        </aapt:attr>
    </path>

    <!-- Pearly upper atmosphere with a cool blue edge, instead of a flat white cap. -->
    <path android:pathData="M26,53c2,-16 14,-27 29,-27c12,0 22,7 26,18c-5,6 -11,11 -18,11c-9,0 -14,-7 -23,-7c-5,0 -10,2 -14,5z">
